# Konfigurasi Database PostgreSQL (Homelab Docker Compose / Lokal)
DATABASE_URL=postgresql://krl_user:password_rahasia_db_disini@krl-db:5432/krl_prod

# Variabel pembentuk credential Postgres untuk service 'db' di docker-compose.yml
POSTGRES_DB=krl_prod
POSTGRES_USER=krl_user
POSTGRES_PASSWORD=password_rahasia_db_disini

# Rahasia untuk menandatangani JWT. Buat dengan: openssl rand -hex 32 (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Masa berlaku token JWT dalam detik (bawaan 3600 / 1 jam)
JWT_EXPIRES=3600

# production | development
NODE_ENV=production

# URL domain aplikasi di Homelab
APP_URL=https://krl.mamay.my.id

# Port server internal
PORT=3000
