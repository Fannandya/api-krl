# Supabase -> Project Settings -> Database -> Connection string
#   -> pilih "Transaction pooler" (porta 6543), BUKAN direct connection (5432).
#      Tiap invocation serverless membuka koneksi sendiri; direct connection
#      akan menghabiskan jatah koneksi Supabase begitu lalu lintas naik.
#
# Project produksi: dibuat lewat integrasi Supabase bawaan Vercel
# (ref vhxnwyjjylqxyrlcmmmc, region us-east-1). Nilai ini TIDAK sama dengan
# variabel yang otomatis diisi integrasi tersebut (POSTGRES_URL, SUPABASE_URL,
# dst) — aplikasi ini hanya membaca DATABASE_URL, jadi variabel itu harus
# ditambahkan manual di dashboard Vercel (Project -> Settings -> Environment
# Variables). Nilainya sama dengan POSTGRES_URL, cukup buang bagian
# "?...&supa=base-pooler.x" di ujungnya. Jangan pakai POSTGRES_URL_NON_POOLING
# (porta 5432) — itu direct connection, bukan pooler.
DATABASE_URL=postgresql://postgres.vhxnwyjjylqxyrlcmmmc:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Rahasia untuk menandatangani JWT. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Masa berlaku token JWT dalam detik. Nilai ini menentukan sekaligus umur cookie
# sesi dan medan expires_in pada balasan /auth/login. Bawaan 3600 (1 jam).
JWT_EXPIRES=3600

# development | production
NODE_ENV=development

# URL aplikasi (dipakai untuk contoh di halaman dokumentasi)
APP_URL=http://localhost:3000

# Port untuk menjalankan server lokal
PORT=3000
