# Supabase -> Project Settings -> Database -> Connection string
#   -> pilih "Transaction pooler" (porta 6543), BUKAN direct connection (5432).
#      Tiap invocation serverless membuka koneksi sendiri; direct connection
#      akan menghabiskan jatah koneksi Supabase begitu lalu lintas naik.
#
# Project yang sudah disiapkan: krl-data-api (ref kvywfxptoxrcuxwqbeud,
# region ap-southeast-1). Kata sandinya ada di dashboard Supabase; kalau lupa,
# pakai tombol "Reset database password".
DATABASE_URL=postgresql://postgres.kvywfxptoxrcuxwqbeud:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Rahasia untuk menandatangani JWT. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Masa berlaku token JWT dalam detik. Nilai ini menentukan sekaligus umur cookie
# sesi dan medan expires_in pada balasan /auth/login. Bawaan 3600 (1 jam).
JWT_EXPIRES=3600

# development | production
NODE_ENV=development

# URL aplikasi (dipakai untuk contoh di halaman dokumentasi)
APP_URL=http://localhost:3000

# Port untuk menjalankan server lokal
PORT=3000
