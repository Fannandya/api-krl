---
title: Activity Diagram — Permintaan Data dengan JWT + API Key
---
flowchart TD
    START([Klien memanggil<br/>GET /v1/route]) --> LOG1["Pasang pencatat pada event 'finish'"]
    LOG1 --> JWT{"Token JWT sah<br/>dan belum kedaluwarsa?"}

    JWT -- tidak --> E401J["401 unauthorized<br/>silakan masuk terlebih dahulu"]
    JWT -- ya --> ADA{"Header X-API-Key<br/>disertakan?"}

    ADA -- tidak --> E401A["401 unauthorized"]
    ADA -- ya --> HASH["Hitung SHA-256 dari API key"]
    HASH --> CARI[("SELECT dari api_keys<br/>JOIN plans<br/>+ hitung pemakaian hari ini<br/>dalam satu kueri")]

    CARI --> KETEMU{"API key ditemukan?"}
    KETEMU -- tidak --> E401B["401 unauthorized"]

    KETEMU -- ya --> CABUT{"Sudah dicabut?"}
    CABUT -- ya --> E401C["401 unauthorized<br/>API key sudah dicabut"]

    CABUT -- tidak --> MILIK{"API key milik akun<br/>yang sedang masuk?"}
    MILIK -- tidak --> E403["403 forbidden<br/>API key bukan milik akun ini"]

    MILIK -- ya --> HEADER["Pasang header<br/>X-RateLimit-Limit / Remaining / Reset"]
    HEADER --> KUOTA{"Pemakaian hari ini<br/>< kuota paket?"}

    KUOTA -- tidak --> E429["429 quota_exceeded<br/>sertakan reset_at"]
    KUOTA -- ya --> PROSES["Jalankan handler endpoint"]

    PROSES --> GRAF{"Graf jaringan<br/>ada di cache?"}
    GRAF -- tidak --> MUAT[("Baca seluruh line_stations<br/>lalu bangun graf")]
    MUAT --> DIJK
    GRAF -- ya --> DIJK["Dijkstra atas simpul (stasiun, lin)<br/>minimalkan waktu tempuh"]

    DIJK --> ADARUTE{"Rute ditemukan?"}
    ADARUTE -- tidak --> E422["422 unprocessable_entity"]
    ADARUTE -- ya --> TARIF["Hitung tarif dari jarak total,<br/>lin bertarif khusus ditagih terpisah"]
    TARIF --> OK["200 OK dengan leg, transfer, dan tarif"]

    E401J --> KIRIM
    E401A --> KIRIM
    E401B --> KIRIM
    E401C --> KIRIM
    E403 --> KIRIM
    E429 --> KIRIM
    E422 --> KIRIM
    OK --> KIRIM["Respons dikirim ke klien"]

    KIRIM --> FINISH["Event 'finish' menyala"]
    FINISH --> PUNYA{"API key sempat<br/>dikenali?"}
    PUNYA -- tidak --> SELESAI([Selesai])
    PUNYA -- ya --> TULIS[("INSERT INTO request_logs<br/>endpoint, status, latensi")]
    TULIS --> SELESAI

    classDef mulai fill:#10141c,stroke:#10141c,color:#fff
    classDef galat fill:#fcf1f0,stroke:#c0261c,color:#10141c
    classDef data fill:#f2f4f7,stroke:#5a6473
    classDef sukses fill:#eff8f3,stroke:#1f7a4d
    class START,SELESAI mulai
    class E401J,E401A,E401B,E401C,E403,E429,E422 galat
    class CARI,MUAT,TULIS data
    class OK sukses
