{
  "name": "krl-data-api",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS API penyedia data KRL Commuter Line Jabodetabek dengan autentikasi JWT dan API key",
  "main": "api/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "migrate": "node scripts/migrate.js",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:status": "bash scripts/db.sh status",
    "db:reset": "bash scripts/db.sh reset",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "docs": "bash docs/render.sh",
    "test:unit": "node --test tests/fareCalculator.test.js tests/scheduleGenerator.test.js tests/routeEngine.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "supertest": "^7.2.2"
  }
}
